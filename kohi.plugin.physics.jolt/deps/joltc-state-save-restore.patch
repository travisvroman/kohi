+size_t JPH_PhysicsSystem_SaveState(const JPH_PhysicsSystem* system, void* buffer, size_t capacity)
+{
+	JPH_ASSERT(system);
+
+	JPH::StateRecorderImpl recorder;
+	system->physicsSystem->SaveState(recorder, JPH::EStateRecorderState::All);
+	std::string data = recorder.GetData();
+	if (buffer && capacity >= data.size())
+		memcpy(buffer, data.data(), data.size());
+	return data.size();
+}
+
+bool JPH_PhysicsSystem_RestoreState(JPH_PhysicsSystem* system, const void* data, size_t size)
+{
+	JPH_ASSERT(system && data);
+
+	JPH::StateRecorderImpl recorder;
+	recorder.WriteBytes(data, size);
+	recorder.Rewind();
+	return system->physicsSystem->RestoreState(recorder);
+}
