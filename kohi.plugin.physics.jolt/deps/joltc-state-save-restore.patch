+JPH_CAPI size_t JPH_PhysicsSystem_SaveState(const JPH_PhysicsSystem* system, void* buffer, size_t capacity);
+/* Restores state previously written by JPH_PhysicsSystem_SaveState. Returns false if the data does not match the system. */
